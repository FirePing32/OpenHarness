{
  "version": "1",
  "name": "qa-kitchen-sink",
  "description": "Every component switched on, wired to the QA fixtures.",
  "server": {
    "host": "127.0.0.1",
    "port": 8090,
    "modelId": "qa-kitchen-sink",
    "authMode": "none",
    "apiKeyEnv": "QA_HARNESS_KEYS",
    "corsOrigins": [],
    "streamToolEvents": true,
    "requestTimeoutSec": 120
  },
  "model": {
    "provider": "openai",
    "baseUrl": "http://127.0.0.1:18098/v1",
    "model": "mock-primary",
    "apiKeyEnv": "QA_MODEL_KEY",
    "temperature": 0.3,
    "maxTokens": 1024,
    "timeoutSec": 30,
    "retries": 2,
    "fallbacks": [],
    "clientParamPolicy": "respect"
  },
  "prompt": {
    "system": "You are the QA agent.",
    "sections": [
      {
        "title": "Style",
        "content": "Answer in short sentences.",
        "enabled": true
      },
      {
        "title": "Disabled section",
        "content": "THIS MUST NOT APPEAR",
        "enabled": false
      }
    ],
    "includeDateTime": true,
    "includeToolSummary": true,
    "clientSystemPolicy": "append"
  },
  "tools": {
    "builtins": [
      "current_time",
      "calculator",
      "http_fetch",
      "read_file",
      "list_dir",
      "write_file",
      "shell",
      "todo"
    ],
    "httpTools": [
      {
        "name": "qa_lookup",
        "description": "Look up a record by id (QA webhook).",
        "method": "GET",
        "url": "http://127.0.0.1:18099/tool?id={{id}}",
        "headers": {
          "X-QA": "${QA_TOOL_TOKEN}"
        },
        "parameters": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "verbose": {
              "type": "boolean"
            }
          },
          "required": [
            "id"
          ]
        }
      },
      {
        "name": "qa_create",
        "description": "Create a record (QA webhook).",
        "method": "POST",
        "url": "http://127.0.0.1:18099/tool",
        "headers": {
          "Authorization": "Bearer ${QA_TOOL_TOKEN}"
        },
        "parameters": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            }
          },
          "required": [
            "title"
          ]
        }
      }
    ],
    "mcpServers": [
      {
        "name": "qastdio",
        "transport": "stdio",
        "command": "python3",
        "args": [
          "qa/fixtures/mcp_stdio_server.py"
        ],
        "env": {
          "MCP_QA_VAR": "hello-from-spec"
        },
        "url": "",
        "headers": {}
      },
      {
        "name": "qahttp",
        "transport": "http",
        "command": "",
        "args": [],
        "env": {},
        "url": "http://127.0.0.1:18099/mcp",
        "headers": {}
      }
    ],
    "parallel": true,
    "maxParallel": 4,
    "resultMaxChars": 16000,
    "resultTruncation": "head_tail",
    "timeoutSec": 30,
    "clientToolsPolicy": "passthrough",
    "shell": {
      "allowedCommands": [
        "ls",
        "echo",
        "cat"
      ],
      "timeoutSec": 10
    },
    "fetch": {
      "allowedDomains": [
        "127.0.0.1"
      ],
      "maxBytes": 200000
    },
    "files": {
      "readOnly": false
    }
  },
  "skills": {
    "mode": "progressive",
    "items": [
      {
        "name": "refunds",
        "description": "How to handle refund questions.",
        "instructions": "SKILL-REFUNDS-BODY: refunds within 30 days."
      },
      {
        "name": "shipping",
        "description": "Shipping times and carriers.",
        "instructions": "SKILL-SHIPPING-BODY: 3-5 business days."
      }
    ]
  },
  "memory": {
    "staticNotes": "QA-STATIC-NOTE: the customer prefers email.",
    "persistent": true,
    "path": "./qa-data/memory.json",
    "scope": "per_user",
    "autoInject": 5,
    "enableTools": true
  },
  "sessions": {
    "mode": "server",
    "dir": "./qa-data/sessions",
    "headerName": "X-Session-Id",
    "maxMessages": 200
  },
  "context": {
    "maxContextTokens": 64000,
    "strategy": "sliding_window",
    "triggerRatio": 0.8,
    "keepRecentMessages": 12,
    "summaryPrompt": "Summarize the conversation so far for your own future reference. Keep facts, decisions, open tasks, file paths and tool results that still matter. Be concise.",
    "pruneToolResults": true,
    "pruneKeepLast": 6,
    "pruneMaxChars": 2000
  },
  "loop": {
    "strategy": "react",
    "maxSteps": 8,
    "maxToolCalls": 20,
    "timeBudgetSec": 120,
    "onToolError": "continue",
    "onMaxSteps": "summarize",
    "planningPrompt": "Before acting, write a short numbered plan for how you will answer the request. Do not call tools yet.",
    "selfCheck": {
      "enabled": false,
      "maxRevisions": 1,
      "prompt": "Review your draft answer against the user's request. If it is complete and correct reply with exactly APPROVED. Otherwise reply with the corrected final answer only."
    }
  },
  "subagents": [
    {
      "name": "mathwhiz",
      "description": "Does arithmetic.",
      "systemPrompt": "You are a math sub-agent.",
      "model": "",
      "tools": [
        "calculator"
      ],
      "maxSteps": 4
    }
  ],
  "permissions": {
    "defaultPolicy": "allow",
    "toolPolicies": {
      "shell": "allow",
      "write_file": "allow"
    },
    "approvalWebhook": "",
    "workspaceRoot": "./qa-data/workspace"
  },
  "guardrails": {
    "inputRules": [
      {
        "name": "no-secret-word",
        "type": "keyword",
        "pattern": "swordfish",
        "action": "block"
      }
    ],
    "outputRules": [
      {
        "name": "mask-ids",
        "type": "regex",
        "pattern": "ID-[0-9]{4}",
        "action": "redact"
      }
    ],
    "redactPII": false,
    "maxInputChars": 100000,
    "blockedMessage": "QA: request blocked."
  },
  "hooks": [
    {
      "event": "turn_end",
      "type": "webhook",
      "url": "http://127.0.0.1:18099/hook",
      "blocking": false,
      "timeoutMs": 2000
    }
  ],
  "observability": {
    "logLevel": "info",
    "logFormat": "text",
    "traceFile": "./qa-data/trace.jsonl",
    "traceHeader": true,
    "includeUsage": true
  }
}
